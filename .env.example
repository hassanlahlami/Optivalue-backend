# The Odds API — free tier 500 req/month. Sign up at https://the-odds-api.com (key shown instantly on dashboard).
ODDS_API_KEY=

# football-data.org — OPTIONAL. Free tier ~10 req/min. Register at https://www.football-data.org/client/register
# Historical model fitting uses football-data.co.uk CSVs, which need NO key.
FOOTBALL_DATA_ORG_KEY=

# Free LLM key for plain-language value-bet explanations. Default provider Groq:
# get a free key at https://console.groq.com (no card). Blank = offline template fallback.
LLM_API_KEY=

# Telegram push alerts for high-edge bets (optional). Create a bot via @BotFather to get the
# token; get your chat id from @userinfobot. Blank = alerts disabled (no-op).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
